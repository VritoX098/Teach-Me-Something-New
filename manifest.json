{
  "manifest_version": 3,
  "name": "Teach Me Something New",
  "version": "1.0.0",
  "description": "One click to learn something new. Removes decision fatigue by picking a random topic for you.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teach Me Something New",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://en.wikipedia.org/*",
    "https://api.github.com/*",
    "https://api.dictionaryapi.dev/*"
  ]
}
